[Unit]
Description=WMCDSS - JMA AMeDAS observation ingester (one-shot)
Documentation=https://www.jma.go.jp/bosai/amedas/
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Runs the job inside the already-built backend container so it shares the
# same Python env + DB connectivity as the API service.
ExecStart=/usr/bin/docker compose -f %h/Projects/Weather-Marine-Construction-Decision-Support-System/docker-compose.yml exec -T backend python -m app.jobs.ingest_jma

# Post-hardening, ingest_jma.main() catches transient upstream errors internally
# (4xx/5xx, timeouts, connection drops are tallied into audit detail and the job
# still exits 0). Exit=1 now means an *unexpected* exception bubbled out — that
# is a real failure systemd should surface as red, not mask. Do NOT re-add
# `SuccessExitStatus=0 1` without removing the in-job tolerance first.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=default.target
