# =============================================================================
# WMCDSS — Windows 11 ネイティブ展開用 環境変数テンプレート
# =============================================================================
# このファイルを .env.windows にコピーして実際の値を設定してください。
#   Copy-Item .env.windows.example .env.windows
#
# .env.windows は .gitignore 対象です。git にコミットしないでください。
# 認証情報の参照元: cert/ フォルダの各 .txt ファイル
# =============================================================================

# -----------------------------------------------------------------------------
# アプリケーション
# -----------------------------------------------------------------------------
WMCDSS_DEBUG=false
WMCDSS_EXPOSE_OPENAPI=false

# -----------------------------------------------------------------------------
# データベース
# -----------------------------------------------------------------------------
WMCDSS_DATABASE_URL=postgresql+asyncpg://wmcdss:wmcdss@db:5432/wmcdss
POSTGRES_USER=wmcdss
POSTGRES_PASSWORD=wmcdss
POSTGRES_DB=wmcdss

# -----------------------------------------------------------------------------
# CORS — WebUI アクセス元
# -----------------------------------------------------------------------------
# Windows ホスト IP + ポート (9080)
WMCDSS_CORS_ORIGINS_RAW=http://172.23.10.251:9080,http://localhost:9080,http://127.0.0.1:9080

# -----------------------------------------------------------------------------
# 既存 API キー認証 (管理 API 用、任意)
# -----------------------------------------------------------------------------
# 空のままにするとマスタ書込み時の API キー認証が無効 (開発環境向け)
# 本番時は python -c "import secrets; print(secrets.token_urlsafe(48))" で生成
WMCDSS_API_KEYS_RAW=

# -----------------------------------------------------------------------------
# レート制限
# -----------------------------------------------------------------------------
WMCDSS_RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# JWT 認証
# -----------------------------------------------------------------------------
# 32文字以上のランダム文字列を設定してください
# 生成例: python -c "import secrets; print(secrets.token_hex(32))"
WMCDSS_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_32CHARS_OR_MORE
WMCDSS_JWT_EXPIRE_MINUTES=480

# -----------------------------------------------------------------------------
# ローカルユーザー (一般ログイン)
# -----------------------------------------------------------------------------
# username:bcrypt_hash 形式、カンマ区切り
# ハッシュ生成: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASS', bcrypt.gensalt()).decode())"
# 例: admin:$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WMCDSS_LOCAL_USERS=admin:REPLACE_WITH_BCRYPT_HASH

# -----------------------------------------------------------------------------
# Microsoft 365 / Entra ID 非対話式認証 (ROPC)
# -----------------------------------------------------------------------------
# cert/ADEntraIDCert.txt の値を参照して設定してください
WMCDSS_ENTRA_TENANT_ID=a7232f7a-a9e5-4f71-9372-dc8b1c6645ea
WMCDSS_ENTRA_CLIENT_ID=22e5d6e4-805f-4516-af09-ff09c7c224c4
WMCDSS_ENTRA_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET_FROM_CERT_FOLDER
WMCDSS_ENTRA_AUTHORITY=https://login.microsoftonline.com/a7232f7a-a9e5-4f71-9372-dc8b1c6645ea
WMCDSS_ENTRA_SCOPE=https://graph.microsoft.com/User.Read
# このドメインのメールアドレスのみ M365 ログインを許可
WMCDSS_ENTRA_EMAIL_DOMAIN=mirai-const.co.jp

# -----------------------------------------------------------------------------
# JMA 取得設定
# -----------------------------------------------------------------------------
WMCDSS_JMA_USER_AGENT=wmcdss/1.0 (+contact: kensan1969@gmail.com)

# -----------------------------------------------------------------------------
# タイムゾーン
# -----------------------------------------------------------------------------
TZ=Asia/Tokyo
