# =============================================================================
# WMCDSS — production environment template
# =============================================================================
# Copy this file to `.env.production` on the production host, fill in the
# secret values, and reference it from docker compose:
#
#   docker compose --env-file .env.production up -d
#
# NEVER commit the populated file to git. The example here is safe to commit
# because every value is a placeholder.
#
# Variable naming: pydantic-settings reads `WMCDSS_*` and maps to the lowercase
# attribute on `app.core.config.Settings`. See backend/app/core/config.py.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Always false in production. `true` enables FastAPI debug responses which can
# leak stack traces to the dashboard.
WMCDSS_DEBUG=false

# OpenAPI / interactive docs surface.
# - true  (dev default): /docs, /redoc, /openapi.json are reachable.
# - false (production):  all three return 404 — the schema does not leak the
#                        full endpoint inventory to anonymous traffic.
# Set false in production unless you intentionally publish the schema for
# partner integration.
WMCDSS_EXPOSE_OPENAPI=false

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# asyncpg driver is mandatory — sync drivers (psycopg2) will break the API.
# Production must use a dedicated user with table-scoped privileges (NOT the
# postgres superuser). Rotate the password through your secret store.
WMCDSS_DATABASE_URL=postgresql+asyncpg://wmcdss_app:CHANGE_ME@db.internal:5432/wmcdss

# -----------------------------------------------------------------------------
# Authentication — write-side API keys
# -----------------------------------------------------------------------------
# Comma-separated list of API keys accepted in the `X-API-Key` header. Empty
# list disables auth (DEV ONLY — production MUST set at least one).
#
# Generate cryptographically strong keys, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Provide ≥2 keys to enable rotation without downtime: roll the new key into
# clients, then remove the old one from this list.
#
# Constraints enforced by app.core.security:
#   - ASCII-only (non-ASCII rejected per-request — UTF-8 encode fails closed)
#   - max 512 bytes per key (`_MAX_KEY_LEN`; compare_digest CPU-amplification guard)
WMCDSS_API_KEYS=REPLACE_WITH_TOKEN_URLSAFE_48_VALUE,REPLACE_WITH_SECOND_KEY_FOR_ROTATION

# -----------------------------------------------------------------------------
# Rate limit — write-side flood protection
# -----------------------------------------------------------------------------
# Sliding window: max mutations per identity per 60s. Identity is
# sha256(X-API-Key)[:16] when authenticated, falling back to client IP.
# 0 disables the limiter (dev default). Production starts conservative — bump
# only after measuring real traffic so a buggy client doesn't tarpit itself.
WMCDSS_RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# CORS — dashboard origins
# -----------------------------------------------------------------------------
# Comma-separated list of fully-qualified origins (scheme + host + port). Do
# NOT use wildcards in production — every accepted origin must be enumerated.
WMCDSS_CORS_ORIGINS=https://wmcdss.example.com,https://wmcdss-admin.example.com

# -----------------------------------------------------------------------------
# JMA ingester
# -----------------------------------------------------------------------------
# JMA terms of service require an identifying User-Agent including a contact
# address. Replace with the operations team's address before deploying.
WMCDSS_JMA_USER_AGENT=wmcdss/1.0 (+contact: ops@example.com)

# -----------------------------------------------------------------------------
# Postgres container (only needed if docker-compose.yml stays in use)
# -----------------------------------------------------------------------------
# Production should match WMCDSS_DATABASE_URL — keep these in lockstep or the
# backend will fail to connect after a `docker compose up`.
POSTGRES_USER=wmcdss_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=wmcdss

# -----------------------------------------------------------------------------
# Timezone
# -----------------------------------------------------------------------------
# JMA observation timestamps are JST; staying in Asia/Tokyo avoids the
# every-six-months DST trap on hosts inheriting UTC.
TZ=Asia/Tokyo
