# =============================================================================
# WMCDSS production environment template
# =============================================================================
# Copy to `.env.production`, fill secrets, then start production services:
#
#   docker compose --env-file .env.production -f docker-compose.production.yml up -d --build
#
# The populated `.env.production` file is ignored by git.
# =============================================================================

# -----------------------------------------------------------------------------
# Public access
# -----------------------------------------------------------------------------
WMCDSS_WEBUI_HOST=192.168.0.185
WMCDSS_WEBUI_PORT=9080

# -----------------------------------------------------------------------------
# Application hardening
# -----------------------------------------------------------------------------
WMCDSS_DEBUG=false
WMCDSS_EXPOSE_OPENAPI=false
WMCDSS_RATE_LIMIT_PER_MINUTE=60
TZ=Asia/Tokyo

# Same-origin production UI uses nginx `/api/v1`, but CORS remains explicit for
# browser clients that hit the API through a separate origin during operations.
WMCDSS_CORS_ORIGINS_RAW=http://192.168.0.185:9080

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_USER=wmcdss_app
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE
POSTGRES_DB=wmcdss
WMCDSS_DATABASE_URL=postgresql+asyncpg://wmcdss_app:CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE@db:5432/wmcdss

# -----------------------------------------------------------------------------
# Write API authentication and login sessions
# -----------------------------------------------------------------------------
WMCDSS_API_KEYS_RAW=CHANGE_ME_TOKEN_URLSAFE_48,CHANGE_ME_SECOND_KEY_FOR_ROTATION
WMCDSS_JWT_SECRET=CHANGE_ME_TOKEN_URLSAFE_48
WMCDSS_JWT_EXPIRE_MINUTES=480

# Local users are `username:bcrypt_hash` entries separated by commas.
# Generate a bcrypt hash with the backend image or a trusted admin host.
WMCDSS_LOCAL_USERS=

# -----------------------------------------------------------------------------
# Microsoft 365 / Entra ID login, optional
# -----------------------------------------------------------------------------
WMCDSS_ENTRA_TENANT_ID=
WMCDSS_ENTRA_CLIENT_ID=
WMCDSS_ENTRA_CLIENT_SECRET=
WMCDSS_ENTRA_AUTHORITY=
WMCDSS_ENTRA_SCOPE=https://graph.microsoft.com/User.Read
WMCDSS_ENTRA_EMAIL_DOMAIN=mirai-const.co.jp

# -----------------------------------------------------------------------------
# JMA and Claude AI
# -----------------------------------------------------------------------------
WMCDSS_JMA_USER_AGENT=wmcdss/1.0 (+contact: ops@example.com)
WMCDSS_JMA_WEATHER_INTERVAL_SECONDS=600
WMCDSS_JMA_MARINE_INTERVAL_SECONDS=600

# Keep blank when the existing UI-saved Claude setting file is mounted:
#   ./backend/.wmcdss_ai_settings.json -> /app/data/ai_settings.json
WMCDSS_CLAUDE_API_KEY=
WMCDSS_CLAUDE_MODEL=claude-sonnet-4-6
WMCDSS_AI_SETTINGS_FILE=/app/data/ai_settings.json
